{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GodelVoiceWorkflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "confidence", "steps", "layout", "clarification", "reason"],
  "properties": {
    "kind": {"type": "string", "enum": ["execute", "clarify", "unsupported"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "steps": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_kind", "command", "control_operation", "control_target", "control_value", "configure_target", "security", "query", "arguments", "post_open_actions", "required", "placement"],
        "properties": {
          "step_kind": {"type": "string", "enum": ["command", "control", "configure"]},
          "command": {"type": ["string", "null"]},
          "control_operation": {
            "type": ["string", "null"],
            "enum": [null, "move", "resize", "maximize", "restore", "focus", "close", "export"]
          },
          "control_target": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "command", "security"],
                "properties": {
                  "mode": {"type": "string", "enum": ["last", "focused", "command"]},
                  "command": {"type": ["string", "null"]},
                  "security": {"type": ["string", "null"]}
                }
              }
            ]
          },
          "control_value": {"type": ["string", "null"]},
          "configure_target": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["mode", "command", "security"],
                "properties": {
                  "mode": {"type": "string", "enum": ["last", "focused", "command"]},
                  "command": {"type": "string"},
                  "security": {"type": ["string", "null"]}
                }
              }
            ]
          },
          "query": {"type": ["string", "null"]},
          "security": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["spoken_name", "ticker", "venue", "asset_class", "needs_resolution"],
                "properties": {
                  "spoken_name": {"type": ["string", "null"]},
                  "ticker": {"type": ["string", "null"]},
                  "venue": {"type": ["string", "null"]},
                  "asset_class": {"type": ["string", "null"]},
                  "needs_resolution": {"type": "boolean"}
                }
              }
            ]
          },
          "arguments": {"type": "array", "items": {"type": "string"}, "maxItems": 8},
          "post_open_actions": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["feature", "operation", "value"],
              "allOf": [
                {
                  "if": {"properties": {"value": {"type": "object", "required": ["field", "minimum", "maximum"]}}},
                  "then": {"properties": {"feature": {"const": "range_filter"}, "operation": {"const": "add"}}}
                },
                {
                  "if": {"properties": {"value": {"type": "object", "required": ["items"]}}},
                  "then": {"properties": {"feature": {"const": "list_filter"}, "operation": {"const": "add"}}}
                },
                {
                  "if": {"properties": {"value": {"type": "object", "required": ["field", "value"]}}},
                  "then": {"properties": {"feature": {"const": "boolean_filter"}, "operation": {"const": "add"}}}
                },
                {
                  "if": {"properties": {"value": {"type": "object", "required": ["query", "tab", "max", "venues", "countries", "hide_no_trade"]}}},
                  "then": {"properties": {"feature": {"const": "search"}, "operation": {"const": "configure"}}}
                },
                {
                  "if": {"properties": {"value": {"type": "object", "required": ["minimum", "maximum"], "not": {"required": ["field"]}}}},
                  "then": {"properties": {"feature": {"const": "market_cap"}, "operation": {"const": "set"}}}
                }
              ],
              "properties": {
                "feature": {"type": "string"},
                "operation": {"type": "string"},
                "value": {
                  "anyOf": [
                    {"type": ["string", "number", "boolean", "null"]},
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["field", "minimum", "maximum"],
                      "properties": {
                        "field": {
                          "type": "string",
                          "enum": [
                            "Market Cap (USD)", "P/E (Fwd)", "P/E (TTM)", "P/S (Fwd)", "P/S (TTM)",
                            "P/B (Fwd)", "P/B (TTM)", "P/CF (Fwd)", "P/CF (TTM)", "EPS (Fwd 12mo)",
                            "Rev. (TTM, USD)", "Rev. (Fwd 12mo, USD)",
                            "Net Inc. (TTM, USD)", "Net Inc. (Fwd 12mo, USD)"
                          ]
                        },
                        "minimum": {"type": ["number", "null"]},
                        "maximum": {"type": ["number", "null"]}
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["field", "items"],
                      "properties": {
                        "field": {"type": "string", "enum": ["Currency", "Venue", "HQ Country", "Sector", "Sub-Sector"]},
                        "items": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}}
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["field", "value"],
                      "properties": {
                        "field": {"const": "Private Company"},
                        "value": {"type": "boolean"}
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["query", "tab", "max", "venues", "countries", "hide_no_trade"],
                      "allOf": [{
                        "if": {"properties": {"tab": {"const": "People"}}, "required": ["tab"]},
                        "then": {"properties": {"venues": {"maxItems": 0}, "countries": {"maxItems": 0}, "hide_no_trade": {"const": false}}}
                      }],
                      "properties": {
                        "query": {"type": "string", "maxLength": 200},
                        "tab": {"type": "string", "enum": ["All", "Equities", "Corporate Bonds", "Options", "Sovereign Bonds", "Crypto", "Index", "Futures", "Forex", "People"]},
                        "max": {"type": "integer", "enum": [50, 100, 250, 500]},
                        "venues": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
                        "countries": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
                        "hide_no_trade": {"type": "boolean"}
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["minimum", "maximum"],
                      "properties": {
                        "minimum": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/mostMarketCapBound"}]},
                        "maximum": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/mostMarketCapBound"}]}
                      }
                    }
                  ]
                }
              }
            }
          },
          "required": {"type": "boolean"},
          "placement": {
            "type": ["string", "null"],
            "enum": [null, "full", "left", "right", "top", "bottom", "top-left", "top-right", "bottom-left", "bottom-right"]
          },
          "allOf": [
            {
              "if": {
                "anyOf": [
                  {"properties": {"step_kind": {"const": "command"}, "command": {"enum": ["EQS", "SECF", "MOST"]}}},
                  {
                    "properties": {
                      "step_kind": {"const": "configure"},
                      "configure_target": {
                        "type": "object",
                        "properties": {"command": {"enum": ["EQS", "SECF", "MOST"]}},
                        "required": ["command"]
                      }
                    }
                  }
                ]
              },
              "then": {},
              "else": {
                "properties": {
                  "post_open_actions": {
                    "items": {
                      "properties": {"value": {"type": ["string", "number", "boolean", "null"]}}
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "preserve_existing", "new_screen"],
      "properties": {
        "preset": {"type": "string", "enum": ["research", "market", "comparison", "options", "grid", "focus"]},
        "preserve_existing": {"type": "boolean"},
        "new_screen": {"type": "boolean"}
      }
    },
    "clarification": {"type": ["string", "null"]},
    "reason": {"type": "string", "maxLength": 240}
  },
  "$defs": {
    "mostMarketCapBound": {
      "type": "object", "additionalProperties": false, "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "enum": ["raw", "K", "M", "B", "T"]}
      }
    }
  }
}
