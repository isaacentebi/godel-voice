VOICE_LLM_BASE_URL=https://openrouter.ai/api/v1
VOICE_LLM_API_KEY=
VOICE_LLM_MODEL=openai/gpt-oss-120b
VOICE_LLM_FALLBACK_MODEL=google/gemini-3.6-flash
VOICE_LLM_FALLBACK_PROVIDER_ONLY=google-vertex/global
VOICE_LLM_RESPONSE_FORMAT=json_object
VOICE_LLM_MAX_TOKENS=1800
VOICE_LLM_TEMPERATURE=omit
# Direct compiler defaults (the production two-route policy below overrides these).
VOICE_LLM_RETRIES=1
VOICE_LLM_RETRY_BASE_MS=80
VOICE_LLM_TIMEOUT_MS=8000
# Production routing budgets: keep the normal voice path fast, then use the
# higher-accuracy route only after a transport failure or rejected local plan.
VOICE_LLM_PRIMARY_TIMEOUT_MS=1300
VOICE_LLM_PRIMARY_RETRIES=0
VOICE_LLM_PRIMARY_RETRY_BASE_MS=80
VOICE_LLM_FALLBACK_TIMEOUT_MS=3500
VOICE_LLM_FALLBACK_RETRIES=0
VOICE_LLM_FALLBACK_RETRY_BASE_MS=80
VOICE_LLM_ROUTE_CEILING_MS=4800
# Use VOICE_LLM_TEMPERATURE=omit for models that reject the parameter.
OPENROUTER_PROVIDER_ONLY=cerebras
# Leave PROVIDER_ONLY blank and use "throughput" for OpenRouter's Nitro-style routing.
OPENROUTER_PROVIDER_SORT=
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_REASONING_EFFORT=
OPENROUTER_APP_NAME=Godel Voice

# Optional premium completion voice. It never blocks Godel window actions.
GODEL_VOICE_TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
GODEL_VOICE_TTS_CACHE_ENTRIES=96

# Optional private learning log for compiler failures only. The file is
# bounded, mode 0600, ignored by Git, and redacts API-key-shaped text.
GODEL_VOICE_LEARN_FAILURES=false
# Keep transcript synthesis bounded so grounded local evidence remains responsive.
TRAN_SUMMARY_TIMEOUT_MS=1800

# Optional conversational Jarvis mode. The standard OpenAI key stays only in
# this private server environment and is never copied into the Arc extension.
GODEL_VOICE_REALTIME_ENABLED=false
OPENAI_API_KEY=
GODEL_VOICE_REALTIME_MODEL=gpt-realtime-2.1-mini
GODEL_VOICE_REALTIME_REASONING_EFFORT=low
GODEL_VOICE_REALTIME_VOICE=cedar
GODEL_VOICE_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# low keeps natural pauses together; high ends turns faster but is more eager.
GODEL_VOICE_REALTIME_VAD_EAGERNESS=low
# Opt-in private local transcript/tool audit. No raw audio is stored.
GODEL_VOICE_REALTIME_AUDIT=false
