VOICE_LLM_BASE_URL=https://openrouter.ai/api/v1
VOICE_LLM_API_KEY=replace-with-your-openrouter-key
VOICE_LLM_MODEL=openai/gpt-oss-120b
VOICE_LLM_RESPONSE_FORMAT=json_object
VOICE_LLM_MAX_TOKENS=500
VOICE_LLM_TEMPERATURE=0
# Use VOICE_LLM_TEMPERATURE=omit for models that reject the parameter.
OPENROUTER_PROVIDER_ONLY=groq
# Leave PROVIDER_ONLY blank and use "throughput" for OpenRouter's Nitro-style routing.
OPENROUTER_PROVIDER_SORT=
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_REQUIRE_PARAMETERS=true
OPENROUTER_REASONING_EFFORT=minimal
OPENROUTER_APP_NAME=Godel Voice
