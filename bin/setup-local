#!/bin/zsh
set -euo pipefail

project_dir="${0:A:h:h}"
secret_file="$project_dir/.godel-voice-secret"
config_file="$project_dir/extension/config.local.js"

if [[ -f "$secret_file" ]]; then
  secret="$(<"$secret_file")"
else
  secret="$(/usr/bin/openssl rand -hex 24)"
  /usr/bin/printf '%s\n' "$secret" > "$secret_file"
  /bin/chmod 600 "$secret_file"
fi

/usr/bin/printf '%s\n' \
  'globalThis.GodelVoiceConfig = {' \
  '  handoffUrl: "http://127.0.0.1:17841",' \
  "  secret: \"$secret\"," \
  '  spokenFeedback: true,' \
  '  cleanupVoiceOnStart: true' \
  '};' > "$config_file"
/bin/chmod 600 "$secret_file" "$config_file"
[[ ! -f "$project_dir/.env" ]] || /bin/chmod 600 "$project_dir/.env"

print "Local Godel Voice handoff configured"
if [[ "${GODEL_VOICE_SKIP_SERVICE_INSTALL:-0}" != "1" ]]; then
  "$project_dir/bin/godel-voice-service" install
fi
