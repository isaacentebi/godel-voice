{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Godel HCP and TAS nested voice architecture",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "operation", "value"],
      "properties": {
        "feature": { "const": "range" },
        "operation": { "const": "set" },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "period", "from", "to"],
              "properties": {
                "kind": { "const": "Preset" },
                "period": { "enum": ["1W", "1M", "3M", "6M", "1Y"] },
                "from": { "type": "null" },
                "to": { "type": "null" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "period", "from", "to"],
              "properties": {
                "kind": { "const": "Custom" },
                "period": { "type": "null" },
                "from": { "type": "string", "format": "date" },
                "to": { "type": "string", "format": "date" }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "operation", "value"],
      "properties": {
        "feature": { "const": "page" },
        "operation": { "const": "select" },
        "value": { "enum": ["Previous", "Next"] }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "operation", "value"],
      "properties": {
        "feature": { "const": "table" },
        "operation": { "const": "configure" },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns", "price_flash", "milliseconds"],
          "properties": {
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1, "maxLength": 64 }
            },
            "price_flash": { "type": "boolean" },
            "milliseconds": { "type": "boolean" }
          }
        }
      }
    }
  ],
  "$defs": {
    "hcpGroundedRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "open", "high", "low", "close", "volume", "source"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "open": { "type": "number", "minimum": 0 },
        "high": { "type": "number", "minimum": 0 },
        "low": { "type": "number", "minimum": 0 },
        "close": { "type": "number", "minimum": 0 },
        "volume": { "type": "number", "minimum": 0 },
        "source": { "const": "Godel HCP table" }
      }
    }
  },
  "x-runtime-enabled": false,
  "x-hcp-page-size": 100,
  "x-tas-state-policy": "Every mutation requires authoritative current configuration and the exact live column vocabulary",
  "x-no-invention": "HCP narration is allowed only from exact validated Godel HCP table rows"
}
