{
  "manifest_version": 3,
  "name": "Godel Voice Executor",
  "version": "0.1.0",
  "description": "Executes validated Godel Terminal voice plans inside the Godel web app.",
  "content_scripts": [
    {
      "matches": ["https://app.godelterminal.com/*"],
      "js": ["core.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["https://app.godelterminal.com/*"]
}
